APP_ENV=testing

# The database the suite runs on. new-site.sh rewrites this block with the
# site's own MySQL credentials, so the tests exercise the same engine as
# production instead of SQLite — a schema or a query that only works on SQLite
# then fails here, not on the day of the deploy.
#
# These defaults keep a bare template checkout runnable without any database.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
