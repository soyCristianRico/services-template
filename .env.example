APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Geographic dimension: locations + category×location landings.
# true  = programmatic local SEO (the template's default shape).
# false = catalog site with no geography; hides Locations and Landings from the
#         admin and drops the /{slug} landing route. No code is removed.
# Derived from the source site by /services-map-source — see config/site.php.
SITE_LOCATIONS=true

# SEO / structured data (JSON-LD + Open Graph) — all optional.
# Default OG image used when a page provides none. Path relative to public/ (asset()).
SEO_DEFAULT_IMAGE=images/og-default.png
# Organization name for JSON-LD. Leave empty to reuse APP_NAME (recommended; only set it if the legal/brand name differs).
SEO_ORG_NAME=
# Organization logo for JSON-LD. Path under public/, e.g. images/logo.png
SEO_ORG_LOGO=
# Social profiles for the JSON-LD "sameAs" array (full URLs).
SEO_ORG_LINKEDIN=
SEO_ORG_INSTAGRAM=
SEO_ORG_TWITTER=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# In production add bugsnag: LOG_STACK="single,bugsnag"
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun — recommended for production (driver preinstalled; set these + MAIL_MAILER=mailgun)
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net

# Legal — the entity shown on /legal (aviso legal, privacidad, cookies).
# All optional: the defaults live in config/legal.php and the contact address
# falls back to hola@{APP_URL host}. Set it only if it differs.
LEGAL_EMAIL=

# Leads — where new form submissions are notified.
# Email recipients, comma separated (leave empty to notify the first registered
# user / site owner), e.g. "hola@cliente.com,avisos@agencia.com".
LEAD_NOTIFY_EMAIL=
# Discord incoming webhook URL (leave empty to disable the Discord notification).
DISCORD_WEBHOOK_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Tag Manager — when set, GTM loads (Consent Mode v2) and the cookie banner appears.
# Leave empty to disable all tracking and the cookie banner entirely.
GOOGLE_TAG_MANAGER_ID=
# URL to your cookie policy, shown as a link in the banner. Defaults to the
# value below (see config/services.php); leave it empty to hide the link.
# The URL contains a '#', so it MUST stay quoted or .env reads it as a comment.
COOKIE_POLICY_URL="/legal#cookies"

# Bugsnag — application errors, grouped and with a stack trace.
# Left empty on purpose in local and testing: a broken loop in development would
# otherwise burn the quota and bury the production errors it exists to surface.
BUGSNAG_API_KEY=

# Technical alerts — failed backup, stale backup, full disk, modified crontab.
# This is NOT LEAD_NOTIFY_EMAIL: that one is the client's inbox, and a client can
# do nothing with a swap warning at 03:00. Several addresses, comma separated.
# Empty means the alerts go nowhere, which is fine locally and a mistake in
# production: the whole point of the backup is being told when it stops running.
DEVELOPER_EMAIL=

# Backups — Google Drive as the destination.
# OAuth credentials of a Google Cloud project. IMPORTANT: publish the app. While
# it stays in "testing" mode Google expires the refresh token after 7 days and
# the backup starts failing with nothing but backup:monitor to tell you.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Folder NAME (not an ID) used as the root of the disk; created if missing.
GOOGLE_DRIVE_FOLDER=backups
# Password of the backup archive. Required in production: the zip carries the
# leads with their GDPR consent, everything uploaded from the admin and a copy of
# this very file — and it lands on somebody else's drive.
BACKUP_ARCHIVE_PASSWORD=
